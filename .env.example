# Application
NEXT_PUBLIC_APP_NAME="PN Tours and Travel Air Ticketing"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="PN Tours and Travel"
NEXT_PUBLIC_SUPPORT_PHONE="+256 785360444"
NEXT_PUBLIC_SUPPORT_EMAIL="support@pntoursandtravel.com"
NEXT_PUBLIC_BRAND_LOGO_URL="https://www.image2url.com/r2/default/images/1789406854595-5200c580-b543-4d37-b30f-73c90d73d473.png"

# Flight Supplier (Provider-Agnostic Abstraction)
FLIGHT_PROVIDER=mock
FLIGHT_PROVIDER_ENV=sandbox
FLIGHT_PROVIDER_BASE_URL=
FLIGHT_PROVIDER_CLIENT_ID=
FLIGHT_PROVIDER_CLIENT_SECRET=
FLIGHT_PROVIDER_API_KEY=
FLIGHT_PROVIDER_WEBHOOK_SECRET=

# Payment Gateway (Provider-Agnostic Abstraction)
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# Database & Cache (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction mode connection pooler (port 6543) for runtime & serverless
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. DIRECT_URL: Direct session connection (port 5432) for running Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
REDIS_URL="redis://localhost:6379"

# Security & Session
SESSION_SECRET="development-secret-key-change-in-production-min-32-chars-long"

# Email / Notifications
EMAIL_PROVIDER=mock
EMAIL_FROM="tickets@pntoursandtravel.com"
